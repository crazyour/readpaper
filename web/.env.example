# Required for the Vercel-local fallback (paper text is extracted in-browser).
MINIMAX_API_KEY=

# Optional but recommended for lower cold-start latency. When both are set,
# the paper trainer skips the MiniMax /models discovery request.
# MINIMAX_API_BASE=https://api.minimax.io/v1
# MINIMAX_MODEL=MiniMax-M2.7-highspeed

# Optional. When set, the paper trainer uploads directly to the original
# DeepTutor FastAPI backend and uses its configured parser/model/storage.
# Example: https://api.example.com
NEXT_PUBLIC_API_BASE=
