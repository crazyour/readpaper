# Required for the Vercel-local fallback (paper text is extracted in-browser).
MINIMAX_API_KEY=

# Strongly recommended in production: setting both removes the model-discovery
# request from every cold serverless instance. Use the region that issued the
# API key (`api.minimax.io` or `api.minimaxi.com`).
MINIMAX_API_BASE=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7-highspeed
